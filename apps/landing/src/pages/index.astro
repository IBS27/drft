---
import Day from "../components/Day.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Promise from "../components/Promise.astro";
import Layout from "../layouts/Layout.astro";

// The one thought the page follows: back today in the hero, then captured,
// returned and sat down with across the day.
const thought = "invite the new neighbors over for dinner before it gets weird";
---

<Layout
  title="drft"
  description="Capture a thought the instant it occurs. drft keeps it, links it to what it echoes, and brings one back to you each morning."
>
  <Nav home />
  <main>
    <Hero returned={thought} />
    <Day thought={thought} />
    <Promise />
  </main>
  <Footer />
</Layout>

<script>
  import { observeReveals } from "../scripts/motion";

  observeReveals();
</script>
