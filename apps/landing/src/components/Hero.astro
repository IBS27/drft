---
// The hero is the room itself: the app's capture sheet, writing and keeping
// thoughts on its own, and every kept thought lifting off the sheet to join
// the ones already drifting around it.
import ArrowBendUpLeft from "@phosphor-icons/core/assets/regular/arrow-bend-up-left.svg";
import ArrowRight from "@phosphor-icons/core/assets/bold/arrow-right-bold.svg";
import CaretRight from "@phosphor-icons/core/assets/regular/caret-right.svg";
import Check from "@phosphor-icons/core/assets/bold/check-bold.svg";
import AppleLogo from "@phosphor-icons/core/assets/fill/apple-logo-fill.svg";
import LogoMark from "./LogoMark.astro";

interface Props {
  /** The thought that came back today; it sits under the sheet, as in the app. */
  returned: string;
}
const { returned } = Astro.props;

// Places a kept thought can come to rest, on wide screens only: two bands,
// above and below the hero's content. Depth 1 is nearest.
const slots: { pos: string; depth: 1 | 2 | 3; text: string }[] = [
  { pos: "top-[13%] left-[6%]", depth: 2, text: "maybe it's time to get a dog" },
  { pos: "top-[21%] left-[31%]", depth: 3, text: "would i be happier in a smaller city" },
  { pos: "top-[12%] left-[55%]", depth: 1, text: "a month without instagram, just to see" },
  { pos: "top-[21%] right-[4%]", depth: 2, text: "i think i'm becoming the flaky friend" },
  { pos: "top-[83%] left-[8%]", depth: 1, text: "scan dad's old photo slides into something" },
  { pos: "top-[90%] left-[33%]", depth: 3, text: "a cookbook of only our family recipes" },
  { pos: "top-[84%] left-[57%]", depth: 2, text: "why do my best ideas show up in the shower" },
  { pos: "top-[90%] right-[5%]", depth: 1, text: "could i handle a two-week solo trip" },
];

// Not on screen at first: the sheet writes these, and each one it keeps
// sends the oldest drifting thought back into this queue.
const waiting = [
  "learn to make bread that isn't a brick",
  "what would i do with a whole free year",
  "call grandma about the lemon tree",
];

const title = [
  ["A", "space", "for"],
  ["unfinished", "thoughts"],
];
let wordIndex = 0;
---

<section data-hero class="hero relative isolate overflow-hidden">
  <div aria-hidden="true" class="hero-wash pointer-events-none absolute inset-0"></div>

  <!-- the drift: kept thoughts, felt more than read -->
  <div data-field data-waiting={JSON.stringify(waiting)} aria-hidden="true" class="field pointer-events-none absolute inset-0 hidden select-none lg:block">
    {
      slots.map((slot, i) => (
        <p
          data-slot
          data-fresh
          data-depth={slot.depth}
          class:list={["frag", slot.pos]}
          style={`--i:${i};--dur:${19 + ((i * 7) % 11)}s;--dx:${i % 2 ? -9 : 11}px;--dy:${i % 3 ? 12 : -10}px`}
        >
          {slot.text}
        </p>
      ))
    }
  </div>

  <div
    class="relative z-10 mx-auto grid max-w-[1280px] gap-x-14 gap-y-11 px-5 pt-28 pb-16 sm:px-8 sm:pt-32 lg:min-h-[max(100dvh,44rem)] lg:grid-cols-[1.2fr_1fr] lg:items-center lg:px-10 lg:pt-16 lg:pb-0"
  >
    <div>
      <h1 class="hero-title font-semibold text-ink">
        {
          title.map((line, lineIndex) => (
            <span class="hero-line">
              {line.map((word, i) => (
                <>
                  <span class="hero-word" style={`--i:${wordIndex++}`}>
                    {word}
                  </span>
                  {i < line.length - 1 && " "}
                </>
              ))}
              {/* The sentence ends in the logo: its full stop is the dot, and the caret waits after it. */}
              {lineIndex === title.length - 1 && (
                <span class="hero-mark">
                  <span class="sr-only">.</span>
                  <LogoMark class="h-[0.72em]" />
                </span>
              )}
              {lineIndex < title.length - 1 && " "}
            </span>
          ))
        }
      </h1>
      <p class="hero-rise mt-6 max-w-[30rem] text-[18px] leading-[1.5] text-pt sm:text-[19px]" style="--d:0.5s">
        Capture what's on your mind before it slips away.
      </p>
      <div class="hero-rise mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d:0.62s">
        <a href="/?signin" data-hero-cta class="btn-primary">
          Get started
          <ArrowRight aria-hidden="true" />
        </a>
        <span class="inline-flex items-center gap-2 text-[13.5px] text-pl">
          <AppleLogo aria-hidden="true" class="size-[15px]" />
          iPhone capture, coming to the App Store
        </span>
      </div>
    </div>

    <div data-demo class="relative mx-auto w-full max-w-[608px] lg:mx-0">
      <p class="sr-only">
        The capture sheet from the app: one field and one button. A thought is written, kept, and joins the
        others.
      </p>
      <div
        aria-hidden="true"
        data-sheet
        data-state="empty"
        class="sheet hero-rise flex w-full flex-col rounded-[14px] bg-scr px-5 pt-5 pb-4 shadow-lift ring-1 ring-line ring-inset sm:px-10 sm:pt-8 sm:pb-7 lg:px-8 xl:px-10"
        style="--d:0.3s"
      >
        <span data-now class="text-[14px] text-pl tabular-nums">Tuesday · 9:41 am</span>
        <p
          data-sheet-text
          class="sheet-text mt-3 text-[24px] leading-[1.42] tracking-[-0.014em] text-ink sm:mt-5 sm:text-[30px] lg:text-[26px] xl:text-[30px]"
        >
          <span data-typed></span><span class="sheet-caret"></span><span class="sheet-placeholder text-ph"
            >Write a thought…</span
          >
        </p>
        <div class="mt-4 flex h-[42px] items-center justify-between gap-4">
          <span class="sheet-hints relative h-8 flex-1 text-[13px] text-pl">
            <span data-hint="empty">Unfinished is fine</span>
            <span data-hint="typing" class="max-sm:hidden">Shift ↵ for a new line</span>
            <span data-hint="kept">
              <span
                class="inline-flex h-8 items-center gap-1.5 rounded-full bg-tint px-3.5 text-[13.5px] font-medium text-dot-ink"
              >
                <Check class="size-[14px]" />
                Kept
              </span>
            </span>
          </span>
          <span class="sheet-keep inline-flex h-[42px] items-center gap-2.5 rounded-full px-5 text-[15px]">
            Keep
            <kbd class="font-mono text-[13px] opacity-70 max-sm:hidden">↵</kbd>
          </span>
        </div>
      </div>

      <!-- today's returned thought, where the app keeps it: right under capture -->
      <div
        aria-hidden="true"
        class="hero-rise mt-4 flex items-center gap-4 rounded-[14px] bg-(--back-wash) px-5 py-4 ring-1 ring-(--back-edge) ring-inset sm:px-10 lg:px-8 xl:px-10"
        style="--d:0.42s"
      >
        <span class="flex min-w-0 flex-1 flex-col gap-1.5">
          <span class="flex items-center gap-1.5 text-[12.5px] font-medium text-dot-ink">
            <ArrowBendUpLeft class="size-[14px]" />
            Back today
          </span>
          <span class="text-[15px] leading-[1.45] tracking-[-0.005em] text-ink sm:text-[17px]">{returned}</span>
        </span>
        <CaretRight class="size-[15px] flex-none text-dot-ink/60" />
      </div>
    </div>
  </div>
</section>

<!-- The sheet shows the real day and time, set before first paint. -->
<script is:inline>
  {
    const el = document.querySelector("[data-now]");
    const now = new Date();
    const clock = now.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }).toLowerCase();
    const day = `${now.toLocaleDateString("en-US", { weekday: "long" })} ${now.getDate()} ${now.toLocaleDateString("en-US", { month: "long" })}`;
    if (el) el.textContent = `${day} · ${clock}`;
  }
</script>

<style>
  /* A little warmth behind the sheet, so the paper reads as lit. */
  .hero-wash {
    background: radial-gradient(
      90% 34% at 50% 74%,
      color-mix(in oklab, var(--dot) 8%, transparent),
      transparent 72%
    );
  }
  @media (min-width: 1024px) {
    .hero-wash {
      background: radial-gradient(
        46% 42% at 74% 52%,
        color-mix(in oklab, var(--dot) 9%, transparent),
        transparent 72%
      );
    }
  }

  .hero-title {
    font-size: clamp(2.05rem, 8.6vw, 3.5rem);
    line-height: 1.03;
    letter-spacing: -0.038em;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(2.6rem, 4.4vw, 3.95rem);
    }
    .hero-line {
      display: block;
      white-space: nowrap;
    }
  }

  /* Words settle one after another, out of a blur. */
  .hero-word {
    display: inline-block;
    animation: word-in 1.1s var(--ease-out) both;
    animation-delay: calc(80ms + var(--i) * 75ms);
  }
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(10px);
    }
  }

  .hero-mark {
    display: inline-block;
    margin-left: 0.09em;
  }
  .hero-mark :global(svg) {
    display: inline-block;
    vertical-align: baseline;
  }
  /* The dot lands like the app's "kept" dot: a small spring. */
  .hero-mark :global(.mark-dot) {
    transform-box: fill-box;
    transform-origin: center;
    animation: dot-in 0.9s var(--ease-spring) 0.62s both;
  }
  .hero-mark :global(.mark-caret) {
    animation: caret-in 0.5s ease 0.95s both;
  }
  @keyframes dot-in {
    from {
      transform: scale(0);
    }
  }
  @keyframes caret-in {
    from {
      opacity: 0;
    }
  }

  .hero-rise {
    animation: rise 1.1s var(--ease-out) var(--d, 0s) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }

  /* Drifting thoughts. The parallax rides `translate`, the drift `transform`,
     so the two never fight; a kept thought's flight takes over `transform`
     and hands back to the drift when it lands. */
  .field {
    --px: 0;
    --py: 0;
  }
  .frag {
    position: absolute;
    max-width: 15.5rem;
    transform-origin: 0 0;
    font-size: 14px;
    line-height: 1.42;
    letter-spacing: -0.014em;
    color: var(--ink);
    opacity: var(--op);
    filter: blur(var(--blur));
    translate: calc(var(--px) * var(--par)) calc(var(--py) * var(--par));
    transition:
      translate 1.4s var(--ease-out),
      opacity 0.9s ease;
    animation: drift var(--dur) ease-in-out infinite;
    will-change: transform;
  }
  .frag[data-fresh] {
    animation:
      frag-in 1.8s ease calc(0.7s + var(--i) * 0.11s) backwards,
      drift var(--dur) ease-in-out infinite;
  }
  .frag[data-depth="1"] {
    --op: 0.6;
    --blur: 0px;
    --par: 20px;
    font-size: 15px;
  }
  .frag[data-depth="2"] {
    --op: 0.4;
    --blur: 0px;
    --par: 11px;
  }
  .frag[data-depth="3"] {
    --op: 0.27;
    --blur: 0.7px;
    --par: 5px;
    font-size: 13px;
  }
  .frag[data-leaving] {
    opacity: 0;
  }
  @keyframes drift {
    50% {
      transform: translate3d(var(--dx), var(--dy), 0);
    }
  }
  @keyframes frag-in {
    from {
      opacity: 0;
    }
  }

  /* The sheet: the app's capture field, driven by the script below. */
  .sheet-text {
    min-height: calc(1.42em * 2);
    overflow-wrap: anywhere;
  }
  .sheet-caret {
    display: inline-block;
    width: 2px;
    height: 1.12em;
    margin-right: -2px;
    border-radius: 1px;
    background: var(--dot);
    vertical-align: -0.2em;
    animation: caret-blink 1.1s steps(1) infinite;
  }
  .sheet[data-state="typing"] .sheet-caret {
    margin-left: 1px;
    animation: none;
  }
  /* While the kept words lift off, nothing blinks under them. */
  .sheet[data-state="kept"] .sheet-caret {
    visibility: hidden;
  }
  .sheet:not([data-state="empty"]) .sheet-placeholder {
    display: none;
  }

  .sheet-hints > span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 200ms;
  }
  .sheet[data-state="empty"] [data-hint="empty"],
  .sheet[data-state="typing"] [data-hint="typing"],
  .sheet[data-state="kept"] [data-hint="kept"] {
    opacity: 1;
  }
  .sheet[data-state="kept"] [data-hint="kept"] > span {
    animation: kept-in 0.5s var(--ease-spring) both;
  }
  @keyframes kept-in {
    from {
      transform: scale(0.8);
    }
  }

  .sheet-keep {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--mut);
    font-weight: 500;
    transition:
      background-color 250ms,
      color 250ms,
      box-shadow 250ms,
      scale 160ms var(--ease-out),
      filter 160ms;
  }
  .sheet[data-state="typing"] .sheet-keep {
    background: var(--dot);
    box-shadow: 0 3px 10px -6px color-mix(in oklab, var(--ink) 25%, transparent);
    color: var(--on-dot);
    font-weight: 600;
  }
  .sheet[data-pressing] .sheet-keep {
    scale: 0.95;
    filter: brightness(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .hero-rise,
    .hero-mark :global(.mark-dot),
    .hero-mark :global(.mark-caret),
    .frag,
    .frag[data-fresh],
    .sheet-caret {
      animation: none;
    }
    .frag {
      transition: none;
    }
  }
</style>

<script>
  import { loopWhile, reducedMotion, sleep, typeInto } from "../scripts/motion";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const field = document.querySelector<HTMLElement>("[data-field]");
  const sheet = document.querySelector<HTMLElement>("[data-sheet]");
  const sheetText = document.querySelector<HTMLElement>("[data-sheet-text]");
  const typed = document.querySelector<HTMLElement>("[data-typed]");

  if (hero && field && sheet && sheetText && typed && !reducedMotion()) {
    // Oldest first: the next kept thought takes the place of the one that
    // has been drifting longest.
    const slots = Array.from(field.querySelectorAll<HTMLElement>("[data-slot]"));
    const queue: string[] = JSON.parse(field.dataset.waiting ?? "[]");

    const visible = (el: HTMLElement) => el.offsetParent !== null;
    // A slow lift off the paper, a glide, and a long settle.
    const glide = (t: number) => 1 - (1 - t ** 1.7) ** 3;

    // The kept words lift off the sheet and come to rest in `slot`: the slot
    // itself makes the flight, starting scaled up to sit exactly over the
    // words in the sheet (same wrap, same lines) and following a rising arc.
    const fly = async (slot: HTMLElement, text: string, signal: AbortSignal) => {
      const from = sheetText.getBoundingClientRect();
      const sheetFont = parseFloat(getComputedStyle(sheetText).fontSize);
      const slotStyle = getComputedStyle(slot);
      const slotFont = parseFloat(slotStyle.fontSize);
      const rest = slotStyle.getPropertyValue("--op").trim() || "0.4";
      const blur = slotStyle.getPropertyValue("--blur").trim() || "0px";

      slot.textContent = text;
      slot.style.maxWidth = "none";
      slot.style.width = `${(from.width * slotFont) / sheetFont}px`;
      slot.style.zIndex = "30";
      slot.style.transition = "none";
      slot.removeAttribute("data-fresh");
      slot.removeAttribute("data-leaving");

      // Hold the drift at rest to measure where the slot really is.
      const hold = slot.animate({ transform: ["none", "none"] }, { duration: 1, fill: "forwards" });
      const to = slot.getBoundingClientRect();
      hold.cancel();

      const scale = sheetFont / slotFont;
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      // A quadratic curve whose control point sits above both ends.
      const cx = dx * 0.55;
      const cy = Math.min(dy, 0) - 70 + dy * 0.2;
      const frames: Keyframe[] = [];
      const steps = 48;
      for (let i = 0; i <= steps; i++) {
        const t = glide(i / steps);
        const u = 1 - t;
        const x = u * u * dx + 2 * u * t * cx;
        const y = u * u * dy + 2 * u * t * cy;
        const s = scale + (1 - scale) * Math.min(1, t * 1.25);
        frames.push({
          transform: `translate3d(${x}px, ${y}px, 0) scale(${s})`,
          opacity: String(1 + (Number(rest) - 1) * t),
          filter: `blur(calc(${blur} * ${t}))`,
        });
      }

      typed.textContent = "";
      const flight = slot.animate(frames, { duration: 3200, easing: "linear", fill: "forwards" });
      const land = () => {
        // Restart the drift from rest, so handing over moves nothing.
        slot.style.animation = "none";
        void slot.offsetWidth;
        slot.style.animation = "";
        flight.cancel();
        slot.style.zIndex = "";
        slot.style.transition = "";
      };
      signal.addEventListener("abort", land, { once: true });
      await flight.finished.catch(() => undefined);
      signal.removeEventListener("abort", land);
      if (!signal.aborted) land();
    };

    const sequence = async (signal: AbortSignal) => {
      await sleep(1300, signal);

      const text = queue[0];
      if (text === undefined) return;
      const slot = slots.find(visible);
      // The thought it will replace starts to fade as the new one is written.
      slot?.setAttribute("data-leaving", "");

      sheet.dataset.state = "typing";
      await typeInto(typed, text, signal);
      await sleep(700, signal);

      sheet.setAttribute("data-pressing", "");
      await sleep(150, signal);
      sheet.removeAttribute("data-pressing");
      sheet.dataset.state = "kept";

      // Kept: the written thought leaves the queue, and whatever it replaces
      // on screen goes to the back of it.
      queue.shift();
      queue.push(slot ? (slot.textContent?.trim() ?? "") : text);
      if (slot) {
        slots.push(...slots.splice(slots.indexOf(slot), 1));
        // "Kept" is there for a moment; the thought takes longer to settle.
        void sleep(1500, signal).then(
          () => {
            sheet.dataset.state = "empty";
          },
          () => undefined,
        );
        await fly(slot, text, signal);
      } else {
        // No room to drift (phones): the words lift a little and go.
        const out = typed.animate(
          [
            { opacity: 1, transform: "none", filter: "blur(0)" },
            { opacity: 0, transform: "translateY(-12px)", filter: "blur(6px)" },
          ],
          { duration: 700, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
        );
        typed.style.display = "inline-block";
        await out.finished.catch(() => undefined);
        typed.style.display = "";
        typed.textContent = "";
        await sleep(700, signal);
        sheet.dataset.state = "empty";
      }
      await sleep(900, signal);
    };

    let inView = false;
    const update = loopWhile(
      () => inView && !document.hidden,
      sequence,
      () => {
        typed.textContent = "";
        typed.style.display = "";
        sheet.dataset.state = "empty";
        sheet.removeAttribute("data-pressing");
        for (const slot of slots) slot.removeAttribute("data-leaving");
      },
    );

    new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        inView = entry.isIntersecting;
        update();
      },
      { threshold: 0.35 },
    ).observe(hero);
    document.addEventListener("visibilitychange", update);

    // The field leans a little toward the pointer; nearer thoughts lean more.
    if (window.matchMedia("(pointer: fine)").matches) {
      let frame: number | undefined;
      let x = 0;
      let y = 0;
      hero.addEventListener(
        "pointermove",
        (event) => {
          const rect = hero.getBoundingClientRect();
          x = (event.clientX - rect.left) / rect.width - 0.5;
          y = (event.clientY - rect.top) / rect.height - 0.5;
          frame ??= window.requestAnimationFrame(() => {
            field.style.setProperty("--px", (-x * 2).toFixed(3));
            field.style.setProperty("--py", (-y * 2).toFixed(3));
            frame = undefined;
          });
        },
        { passive: true },
      );
    }
  }
</script>
