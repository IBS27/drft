---
// The logo mark beside "drft", set the way the app sets it.
import LogoMark from "./LogoMark.astro";

interface Props {
  href?: string;
}
const { href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  aria-label={href ? "drft, home" : undefined}
  class="inline-flex items-baseline gap-[0.45em] text-[17px] font-semibold tracking-[-0.02em] text-ink"
>
  <LogoMark class="h-[0.74em]" />
  drft
</Tag>
