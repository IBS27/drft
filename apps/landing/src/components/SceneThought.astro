---
// Sunday: the thought's own page on the web, under a corner of the
// Connections map. Pointing at a related thought lights it on the map, the
// way the app does; left alone, the scene walks through them itself.
import ArrowBendUpLeft from "@phosphor-icons/core/assets/regular/arrow-bend-up-left.svg";
import BookmarkSimple from "@phosphor-icons/core/assets/regular/bookmark-simple.svg";
import Moon from "@phosphor-icons/core/assets/regular/moon.svg";

interface Props {
  thought: string;
  related: { text: string; kept: string }[];
}
const { thought, related } = Astro.props;

const short = (text: string, words: number) => `${text.split(" ").slice(0, words).join(" ")}…`;

// The map: this thought in vermilion, the three it echoes, and one more
// that only the first of them reaches.
const self = { x: 232, y: 90 };
const nodes = [
  { x: 62, y: 38, label: short(related[0]?.text ?? "", 5) },
  { x: 398, y: 32, label: short(related[1]?.text ?? "", 3) },
  { x: 380, y: 136, label: short(related[2]?.text ?? "", 4) },
];
const far = { x: 90, y: 140, label: "sunday dinners at nana's" };
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2 - 10;
  return `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`;
};
---

<div data-thought-scene class="thought-scene" aria-hidden="true">
  <div class="map">
    <svg viewBox="0 0 520 172" width="520" height="172" fill="none">
      <g class="map-edges">
        {nodes.map((node, i) => <path data-i={i} d={curve(self, node)} pathLength="1" style={`--i:${i}`} />)}
        <path d={curve(nodes[0] ?? self, far)} pathLength="1" style="--i:3"></path>
      </g>
      <g class="map-nodes">
        {
          nodes.map((node, i) => (
            <g data-i={i} style={`--i:${i + 1}`}>
              <circle cx={node.x} cy={node.y} r="4.5" />
              <text x={node.x + 11} y={node.y + 4}>
                {node.label}
              </text>
            </g>
          ))
        }
        <g style="--i:4">
          <circle cx={far.x} cy={far.y} r="3.5"></circle>
          <text x={far.x + 10} y={far.y + 4}>{far.label}</text>
        </g>
        <g class="map-self" style="--i:0">
          <circle class="map-halo" cx={self.x} cy={self.y} r="11"></circle>
          <circle cx={self.x} cy={self.y} r="6"></circle>
          <text x={self.x + 13} y={self.y + 4}>{short(thought, 4)}</text>
        </g>
      </g>
    </svg>
  </div>

  <article class="page relative w-full rounded-[14px] bg-scr px-6 pt-6 pb-3 shadow-lift ring-1 ring-line ring-inset sm:px-9 sm:pt-8 sm:pb-4">
    <span class="page-part block text-[13.5px] text-pl tabular-nums" style="--i:0">20 Oct · 9:41 am</span>
    <p
      class="page-part mt-3 text-[23px] leading-[1.3] tracking-[-0.02em] text-pretty text-ink sm:text-[27px]"
      style="--i:1"
    >
      {thought}
    </p>
    <div class="page-part mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-2" style="--i:2">
      <span class="mr-1.5 inline-flex h-7 items-center gap-1.5 text-[13px] font-medium text-dot-ink">
        <ArrowBendUpLeft class="size-[14px]" />
        Back today
      </span>
      <span class="page-pill">
        <BookmarkSimple class="size-[14px]" />
        Hold
      </span>
      <span class="page-pill">
        <Moon class="size-[14px]" />
        Let it rest
      </span>
    </div>

    <div class="page-part mt-7" style="--i:3">
      <span class="text-[14px] font-medium text-pt">Related thoughts</span>
      <ul class="mt-3 border-t border-line">
        {
          related.map((row, i) => (
            <li data-i={i} class:list={["row", i > 0 && "row-divided"]}>
              <span class="min-w-0 flex-1 text-[15.5px] leading-[1.45] text-balance text-ink">{row.text}</span>
              <span class="flex-none text-[13px] text-pl tabular-nums">{row.kept}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</div>

<style>
  .thought-scene {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 33rem;
    margin-inline: auto;
    pointer-events: auto;
  }

  /* A strip of the Connections map, fading out at its edges. */
  .map {
    overflow: hidden;
    margin-bottom: 0.25rem;
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 78%, transparent);
  }
  .map svg {
    display: block;
    max-width: none;
  }
  /* On a phone the strip is drawn a little smaller, so this thought and
     its name stay inside it. */
  @media (max-width: 639px) {
    .map svg {
      width: 416px;
      height: auto;
    }
  }
  .map-edges path {
    stroke: color-mix(in oklab, var(--line) 85%, var(--mut));
    stroke-width: 1;
    stroke-dasharray: 1;
    transition:
      stroke 200ms,
      opacity 200ms,
      stroke-dashoffset 1.1s var(--ease-out) calc(0.3s + var(--i) * 0.12s);
  }
  .map-nodes g {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 200ms,
      scale 0.8s var(--ease-spring) calc(0.15s + var(--i) * 0.11s);
  }
  .map-nodes circle {
    fill: var(--mut);
    stroke: var(--pg);
    stroke-width: 1.5;
    transition: fill 200ms;
  }
  .map-nodes text {
    fill: var(--pt);
    stroke: var(--pg);
    stroke-width: 4;
    stroke-linejoin: round;
    paint-order: stroke;
    font-size: 11.5px;
    transition: fill 200ms;
  }
  .map-self circle {
    fill: var(--dot);
  }
  .map-self .map-halo {
    fill: color-mix(in oklab, var(--dot) 15%, transparent);
    stroke: none;
  }
  .map-self text {
    fill: var(--ink);
    font-weight: 500;
  }

  /* One related thought in focus: its row, its dot and its line step
     forward; the rest of the map steps back. */
  .thought-scene[data-focusing] .map-edges path:not([data-on]),
  .thought-scene[data-focusing] .map-nodes g:not([data-on]):not(.map-self) {
    opacity: 0.35;
  }
  .map-edges path[data-on] {
    stroke: var(--mut);
  }
  .map-nodes g[data-on] circle {
    fill: var(--ink);
  }
  .map-nodes g[data-on] text {
    fill: var(--ink);
  }

  .page-pill {
    display: inline-flex;
    height: 2.125rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    background: var(--scr);
    padding-inline: 0.9rem;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--pt);
    font-size: 13.5px;
    font-weight: 500;
  }

  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-inline: -0.625rem;
    border-radius: 10px;
    padding: 0.8rem 0.625rem;
    transition: background-color 200ms;
  }
  .row[data-on] {
    background: var(--tint);
  }
  /* The app's inset hairline, stepping aside for a lit row. */
  .row-divided::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0.625rem;
    right: 0.625rem;
    height: 1px;
    background: var(--line);
    transition: opacity 150ms;
  }
  .row[data-on]::before,
  .row[data-on] + .row::before {
    opacity: 0;
  }

  .page-part {
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(0.2s + var(--i) * 0.11s);
  }

  /* Before its scene is active: the page's parts wait below their places,
     the map's lines are undrawn and its dots unplaced. */
  :global(.js .scene:not([data-active])) .page-part {
    opacity: 0;
    transform: translateY(12px);
    transition-delay: 0s;
  }
  :global(.js .scene:not([data-active])) .map-edges path {
    stroke-dashoffset: 1;
    transition-delay: 0s;
    transition-duration: 0.2s;
  }
  :global(.js .scene:not([data-active])) .map-nodes g {
    opacity: 0;
    scale: 0;
    transition-delay: 0s;
    transition-duration: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-part,
    .map-edges path,
    .map-nodes g {
      opacity: 1 !important;
      transform: none !important;
      scale: 1 !important;
      stroke-dashoffset: 0 !important;
      transition: none;
    }
  }
</style>
